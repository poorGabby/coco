# CoCo 配置模板。只填写到本地或 Secret Manager，不要把真实值提交到 Git。

# 必填：飞书企业自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_OPEN_ID=
FEISHU_REPORT_CHAT_ID=

# 可选：飞书知识库范围
FEISHU_WIKI_SPACE_IDS=
FEISHU_WIKI_ROOT_TOKENS=
FEISHU_WIKI_DOC_TOKENS=
FEISHU_WIKI_INDEX_DOC_TOKEN=
FEISHU_COCO_BEHAVIOR_DOC_TOKEN=
FEISHU_COCO_ANALYSIS_DOC_TOKEN=
FEISHU_COCO_SKILL_DOC_TOKEN=

# 必填：LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
HERMES_INFERENCE_PROVIDER=gemini

# 必填：Amplitude
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
AMPLITUDE_RETENTION_CHART_IDS=
AMPLITUDE_DAILY_CHART_IDS=
AMPLITUDE_DASHBOARD_URL=

# 可选：真实收入；为空时回退到 Amplitude 购买人数 × 单价
STRIPE_API_KEY=

# 两层服务之间及定时任务鉴权
COCO_MCP_KEY=
HERMES_CRON_SECRET=
API_SERVER_KEY=

# Hermes Agent 运行开关
HERMES_AGENT_ENABLED=
HERMES_MCP_ENABLED=
HERMES_MCP_SERVERS=
HERMES_EXEC_ASK=1
HERMES_QUIET=1
GATEWAY_ALLOW_ALL_USERS=true

# Cloud Run 本地开发端口
PORT=8787

# 当前未启用/预留的数据源
WIX_SITE_URL=
WIX_SITE_ID=
WIX_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=

# 仅本地开发可能需要；不能上传到 GCE/Cloud Run
# HTTPS_PROXY=http://127.0.0.1:7890
